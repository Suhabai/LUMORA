{
  "meta": {
    "name": "LUMORA Typography",
    "version": "1.0.0",
    "description": "Typography scale and font configuration for LUMORA design system"
  },
  "fontFamily": {
    "sans": ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"],
    "mono": ["Geist Mono", "SF Mono", "Fira Code", "monospace"]
  },
  "scale": {
    "hero": {
      "size": "clamp(3rem, 8vw, 6.5rem)",
      "weight": 700,
      "tracking": "-0.04em",
      "lineHeight": 0.94
    },
    "h1": {
      "size": "clamp(2rem, 4.5vw, 3.5rem)",
      "weight": 700,
      "tracking": "-0.03em",
      "lineHeight": 1.08
    },
    "h2": {
      "size": "clamp(1.5rem, 3vw, 2.5rem)",
      "weight": 600,
      "tracking": "-0.02em",
      "lineHeight": 1.2
    },
    "h3": {
      "size": "1.25rem",
      "weight": 600,
      "tracking": "-0.01em",
      "lineHeight": 1.4
    },
    "body": {
      "size": "1rem",
      "weight": 400,
      "tracking": "normal",
      "lineHeight": 1.6
    },
    "small": {
      "size": "0.875rem",
      "weight": 400,
      "tracking": "normal",
      "lineHeight": 1.5
    },
    "label": {
      "size": "0.6875rem",
      "weight": 600,
      "tracking": "0.14em",
      "lineHeight": 1,
      "transform": "uppercase"
    }
  },
  "color": {
    "primary": "#f5f5f7",
    "muted": "#7a7a8e",
    "faint": "#4a4a5a",
    "accent": "#8a2eff"
  },
  "css": {
    "--font-sans": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
  }
}
