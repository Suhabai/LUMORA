{
  "meta": {
    "name": "LUMORA Motion",
    "version": "1.0.0",
    "description": "Animation duration, easing, and keyframe tokens for LUMORA design system"
  },
  "duration": {
    "instant": "100ms",
    "fast": "200ms",
    "normal": "400ms",
    "slow": "600ms",
    "glacial": "1200ms"
  },
  "easing": {
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "ease-in": "cubic-bezier(0.55, 0.085, 0.68, 0.53)",
    "linear": "linear"
  },
  "keyframes": {
    "pulse-soft": {
      "0%, 100%": { "opacity": 0.4 },
      "50%": { "opacity": 0.8 }
    },
    "float": {
      "0%, 100%": { "transform": "translateY(0)" },
      "50%": { "transform": "translateY(-6px)" }
    }
  },
  "animation": {
    "pulse": "pulse-soft 3s ease-in-out infinite",
    "float": "float 6s ease-in-out infinite"
  },
  "component": {
    "hover-scale": {
      "duration": "200ms",
      "scale": 1.02
    },
    "hover-lift": {
      "duration": "400ms",
      "y": -4
    },
    "scroll-reveal": {
      "duration": "600ms",
      "y": 24,
      "opacity": 0
    },
    "stagger": {
      "delay": "100ms"
    }
  },
  "css": {
    "--ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "--animate-pulse": "pulse-soft 3s ease-in-out infinite",
    "--animate-float": "float 6s ease-in-out infinite"
  }
}
