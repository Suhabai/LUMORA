{
  "meta": {
    "name": "LUMORA Z-Index",
    "version": "1.0.0",
    "description": "Layering and stacking context tokens for LUMORA design system"
  },
  "scale": {
    "behind": -1,
    "base": 0,
    "raised": 1,
    "dropdown": 10,
    "sticky": 20,
    "overlay": 30,
    "modal": 40,
    "popover": 50,
    "toast": 60,
    "cursor": 9999
  },
  "layers": {
    "background": {
      "z-index": -1,
      "description": "Background decorations and gradients"
    },
    "content": {
      "z-index": 0,
      "description": "Main content layer"
    },
    "navigation": {
      "z-index": 40,
      "description": "Sticky navigation header"
    },
    "overlay": {
      "z-index": 30,
      "description": "Page overlays and backdrops"
    },
    "modal": {
      "z-index": 50,
      "description": "Modal dialogs and popovers"
    },
    "cursor": {
      "z-index": 9999,
      "description": "Custom cursor elements"
    }
  },
  "usage": {
    "sticky-navigation": 40,
    "mobile-menu": 50,
    "scan-line": 100,
    "custom-cursor": 9999,
    "skip-link": 9999
  },
  "css": {
    "--z-behind": "-1",
    "--z-base": "0",
    "--z-raised": "1",
    "--z-dropdown": "10",
    "--z-sticky": "20",
    "--z-overlay": "30",
    "--z-modal": "40",
    "--z-popover": "50",
    "--z-toast": "60",
    "--z-cursor": "9999"
  }
}
