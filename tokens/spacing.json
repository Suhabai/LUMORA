{
  "meta": {
    "name": "LUMORA Spacing",
    "version": "1.0.0",
    "description": "Spacing scale and layout values for LUMORA design system"
  },
  "scale": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem",
    "3xl": "4rem",
    "4xl": "6rem"
  },
  "layout": {
    "container": {
      "mobile": "1rem",
      "tablet": "1.5rem",
      "desktop": "clamp(1.5rem, 5vw, 3rem)"
    },
    "section": {
      "mobile": "4rem",
      "tablet": "6rem",
      "desktop": "clamp(6rem, 14vh, 12rem)"
    },
    "grid": {
      "gap": "1.5rem",
      "gap-lg": "2rem"
    }
  },
  "component": {
    "button": {
      "padding-x": {
        "sm": "1.25rem",
        "md": "1.75rem",
        "lg": "2.25rem"
      },
      "padding-y": {
        "sm": "0.5rem",
        "md": "0.75rem",
        "lg": "1rem"
      }
    },
    "card": {
      "padding": "2rem"
    },
    "badge": {
      "padding-x": "1rem",
      "padding-y": "0.375rem"
    }
  },
  "css": {
    "--spacing-section": "clamp(6rem, 14vh, 12rem)",
    "--spacing-container": "clamp(1.5rem, 5vw, 3rem)"
  }
}
